{
  "name": "muscle-atlas-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/export-squat-evidence.mjs && node scripts/export-press-evidence.mjs && node scripts/export-tsm-upper-bone-registration.mjs && node scripts/export-tsm-pectoralis-atlas-registration.mjs && tsc --noEmit && vite build && node scripts/inline-build-assets.mjs",
    "build:squat-evidence": "node scripts/export-squat-evidence.mjs",
    "build:press-evidence": "node scripts/export-press-evidence.mjs",
    "check:kinematics": "node scripts/check-kinematics.mjs",
    "check:body-measurements": "node scripts/check-body-measurements.mjs",
    "check:reference-shape": "node scripts/check-reference-shape.mjs",
    "check:pectoralis-proxies": "node scripts/check-pectoralis-proxies.mjs",
    "check:pectoralis-atlas": "node scripts/check-pectoralis-atlas.mjs",
    "check:deltoid-atlas": "node scripts/check-deltoid-atlas.mjs",
    "check:external-moments": "node scripts/check-external-moments.mjs",
    "check:study-moment-overlay": "node scripts/check-study-moment-overlay.mjs",
    "check:press-benchmark": "node scripts/check-press-benchmark.mjs",
    "benchmark:bench-velocity": "python scripts/benchmark_bench_velocity.py",
    "benchmark:bench-group-path": "python scripts/benchmark_bench_group_path.py",
    "check:bench-tempo": "node scripts/check-bench-tempo.mjs",
    "probe:squat-balance": "node scripts/probe_squat_balance.mjs",
    "probe:squat-dynamic-grf": "node scripts/probe_squat_dynamic_grf.mjs",
    "benchmark:squat-template-grf": "python scripts/benchmark_template_squat_grf.py",
    "benchmark:squat-loaded-grf": "node scripts/export_loaded_squat_template.mjs && python scripts/benchmark_loaded_squat_template.py",
    "check:opensim-lookup": "node scripts/check-opensim-lookup.mjs",
    "check:arm26-lookup": "node scripts/check-arm26-lookup.mjs",
    "check:tsm-lookup": "node scripts/check-tsm-lookup.mjs",
    "check:tsm-bench-lookup": "node scripts/check-tsm-bench-lookup.mjs",
    "check:offline-cache": "node scripts/check-offline-cache.mjs",
    "build:squat-angles": "node scripts/export-squat-angles.mjs",
    "build:blender-poses": "node scripts/export-blender-poses.mjs",
    "android:sync": "npm run build && cap sync android",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.2",
    "three": "^0.181.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/three": "^0.181.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  }
}
